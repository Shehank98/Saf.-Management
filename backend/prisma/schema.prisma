generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER MANAGEMENT ====================

enum UserRole {
  SUPER_ADMIN
  SAFARI_OWNER
  VENDOR
  CUSTOMER
}

enum VendorType {
  JEEP_PROVIDER
  GUIDE
  RESTAURANT
  ACCOMMODATION
  CAMERA_RENTAL
  OTHER
}

enum VendorStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
  EXPIRED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String   @unique
  password  String
  role      UserRole
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor          Vendor?
  safariOwner     SafariOwner?
  customerProfile Customer?
  refreshTokens   RefreshToken[]

  @@index([email, phone])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Vendor {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorType      VendorType
  businessName    String
  businessAddress String?
  taxId           String?
  bankDetails     Json?

  subscriptionStatus VendorStatus @default(PENDING_PAYMENT)
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  monthlyFee         Decimal      @default(1000.00)

  isAvailable  Boolean    @default(true)
  blockedDates DateTime[]

  averageRating Decimal? @db.Decimal(3, 2)
  totalReviews  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jeepAssignments      JeepAssignment[]
  guideAssignments     GuideAssignment[]
  mealOrders           MealOrder[]
  payments             VendorPayment[]
  subscriptionPayments SubscriptionPayment[]

  @@index([vendorType, subscriptionStatus])
}

model SafariOwner {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  companyAddress String
  taxId         String?

  subscriptionStatus VendorStatus @default(PENDING_PAYMENT)
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  monthlyFee         Decimal      @default(2500.00)
  subscriptionMonths Int          @default(1)

  depositPercentage      Decimal @default(30.00)
  sharedSafariCommission Decimal @default(15.00)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  privateSafaris PrivateSafari[]
  sharedJeeps    SharedJeep[]
  ownerPayments  OwnerSubscriptionPayment[]

  @@index([subscriptionStatus])
}

model Customer {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address String?
  preferences Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  privateSafariBookings PrivateSafariBooking[]
  sharedSafariBookings  SharedSafariBooking[]
  reviews               Review[]
}

// ==================== PRIVATE SAFARI SYSTEM ====================

enum PrivateSafariStatus {
  INQUIRY
  DEPOSIT_PENDING
  DEPOSIT_PAID
  CONFIRMED
  COMPLETED
  CANCELLED
}

model PrivateSafari {
  id             String              @id @default(cuid())
  ownerId        String
  owner          SafariOwner         @relation(fields: [ownerId], references: [id])
  safariDate     DateTime
  safariType     String
  numberOfGuests Int
  status         PrivateSafariStatus @default(INQUIRY)

  totalAmount   Decimal
  depositAmount Decimal
  depositPaid   Boolean @default(false)
  finalPaid     Boolean @default(false)

  guideId         String?
  jeepId          String?
  restaurantId    String?
  accommodationId String?

  vendorCosts Decimal @default(0)
  profit      Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking         PrivateSafariBooking?
  jeepAssignment  JeepAssignment?
  guideAssignment GuideAssignment?
  mealOrders      MealOrder[]

  @@index([ownerId, safariDate, status])
}

model PrivateSafariBooking {
  id       String        @id @default(cuid())
  safariId String        @unique
  safari   PrivateSafari @relation(fields: [safariId], references: [id], onDelete: Cascade)

  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  specialRequests String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, safariId])
}

// ==================== SHARED SAFARI SYSTEM ====================

enum SharedJeepStatus {
  OPEN
  PENDING_PAYMENT
  CONFIRMED
  FULLY_BOOKED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  RESERVED
  PAYMENT_PENDING
  PAID
  CONFIRMED
  AUTO_CANCELLED
  RELEASED
  CANCELLED
  REFUNDED
}

model SharedJeep {
  id          String           @id @default(cuid())
  ownerId     String
  owner       SafariOwner      @relation(fields: [ownerId], references: [id])
  safariDate  DateTime
  safariType  String
  status      SharedJeepStatus @default(OPEN)

  totalSeats    Int @default(6)
  reservedSeats Int @default(0)
  paidSeats     Int @default(0)

  pricePerSeat Decimal

  paymentDeadline DateTime?
  safariDeadline  DateTime

  assignedGuideId String?
  assignedJeepId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings        SharedSafariBooking[]
  jeepAssignment  JeepAssignment?
  guideAssignment GuideAssignment?
  mealOrders      MealOrder[]

  @@index([ownerId, safariDate, status])
  @@index([safariDate, safariType])
}

model SharedSafariBooking {
  id       String     @id @default(cuid())
  jeepId   String
  jeep     SharedJeep @relation(fields: [jeepId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  seatNumber   Int
  rowPosition  String

  status BookingStatus @default(RESERVED)

  basePrice    Decimal
  mealPrice    Decimal @default(0)
  cameraRental Decimal @default(0)
  totalAmount  Decimal

  paymentLinkSent DateTime?
  paymentDeadline DateTime?
  paidAt          DateTime?
  paymentId       String?

  pickupLocation String
  pickupLat      Decimal @db.Decimal(10, 8)
  pickupLng      Decimal @db.Decimal(11, 8)
  pickupTime     String

  mealIncluded Boolean  @default(false)
  mealTypes    String[]
  dietaryReqs  String[]
  allergies    String?
  specialNotes String?

  cameraNeeded Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jeepId, seatNumber])
  @@index([customerId, status])
  @@index([jeepId, status])
}

// ==================== VENDOR ASSIGNMENTS ====================

model JeepAssignment {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  privateSafariId String?       @unique
  privateSafari   PrivateSafari? @relation(fields: [privateSafariId], references: [id])

  sharedJeepId String?     @unique
  sharedJeep   SharedJeep? @relation(fields: [sharedJeepId], references: [id])

  jeepNumber    String
  rentalFee     Decimal
  paymentStatus String    @default("PENDING")
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, paymentStatus])
}

model GuideAssignment {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  privateSafariId String?       @unique
  privateSafari   PrivateSafari? @relation(fields: [privateSafariId], references: [id])

  sharedJeepId String?     @unique
  sharedJeep   SharedJeep? @relation(fields: [sharedJeepId], references: [id])

  guideFee      Decimal
  paymentStatus String    @default("PENDING")
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, paymentStatus])
}

model MealOrder {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  privateSafariId String?
  privateSafari   PrivateSafari? @relation(fields: [privateSafariId], references: [id])

  sharedJeepId String?
  sharedJeep   SharedJeep? @relation(fields: [sharedJeepId], references: [id])

  numberOfMeals Int
  mealTypes     String[]
  dietaryReqs   Json
  specialNotes  String?
  totalCost     Decimal
  paymentStatus String    @default("PENDING")
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, paymentStatus])
}

// ==================== PAYMENTS & BILLING ====================

model VendorPayment {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  amount          Decimal
  description     String
  relatedSafariId String?
  paymentProof    String?
  status          String    @default("PENDING")
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, status])
}

model SubscriptionPayment {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  amount        Decimal
  monthsCovered Int    @default(1)
  paymentProof  String?
  paymentMethod String?
  status        String    @default("PENDING")
  paidAt        DateTime?
  validFrom     DateTime
  validUntil    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, status])
}

model OwnerSubscriptionPayment {
  id      String      @id @default(cuid())
  ownerId String
  owner   SafariOwner @relation(fields: [ownerId], references: [id])

  amount        Decimal
  monthsCovered Int
  paymentProof  String?
  paymentMethod String?
  status        String    @default("PENDING")
  paidAt        DateTime?
  validFrom     DateTime
  validUntil    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
}

model SuperAdminCommission {
  id           String  @id @default(cuid())
  sharedJeepId String

  totalRevenue     Decimal
  commissionRate   Decimal
  commissionAmount Decimal
  status           String    @default("PENDING")
  collectedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ==================== REVIEWS & RATINGS ====================

model Review {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  safariType       String
  safariId         String
  rating           Int
  comment          String?
  photos           String[]
  googleReviewLink String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, safariType])
}

// ==================== NOTIFICATIONS ====================

enum NotificationType {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model Notification {
  id             String             @id @default(cuid())
  recipientId    String
  recipientPhone String?
  recipientEmail String?

  type   NotificationType
  status NotificationStatus @default(PENDING)

  subject      String?
  message      String
  templateName String?
  templateData Json?

  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?
  retryCount    Int       @default(0)
  maxRetries    Int       @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([recipientId, type])
}

// ==================== SYSTEM SETTINGS ====================

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}
