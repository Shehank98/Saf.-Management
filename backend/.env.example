# =============================================
# Railway automatically injects DATABASE_URL
# and PORT — do NOT set those manually there.
# Add the rest in Railway → Variables tab.
# =============================================

# Database (Railway injects this automatically when you add PostgreSQL)
DATABASE_URL=postgresql://user:password@host.railway.internal:5432/railway

# Redis (Railway injects this when you add Redis addon)
REDIS_URL=redis://default:password@host.railway.internal:6379

# JWT
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# Stripe
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google Maps
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_key

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=safari-uploads
AWS_REGION=ap-south-1

# App URLs — set to your Railway public URL
APP_URL=https://your-app.up.railway.app
# ALLOWED_ORIGINS is optional; leave blank to allow all (mobile app needs this)
# ALLOWED_ORIGINS=https://your-web-app.vercel.app

# Geofencing base location (Yala / your park entrance)
BASE_LAT=6.3553
BASE_LNG=81.5182
PICKUP_RADIUS_KM=7

# Node
NODE_ENV=production
LOG_LEVEL=info
