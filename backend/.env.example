# Database
DATABASE_URL=postgresql://user:password@localhost:5432/safari_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google Maps
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_key

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=safari-uploads
AWS_REGION=ap-south-1

# App
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Geofencing
BASE_LAT=6.9271
BASE_LNG=79.8612
PICKUP_RADIUS_KM=7

# Fees
VENDOR_MONTHLY_FEE=1000
OWNER_MONTHLY_FEE=2500
SHARED_SAFARI_COMMISSION=15

# Logging
LOG_LEVEL=info
